#!/bin/sh
# Called by goimapnotify when a mail arrives: notification with the sender and subject of the last mail.
# goimapnotify also fires a fake event at its start: ignored if it is less than 10 s old.
# Read through the local Proton bridge (credentials from the keyring, see goimapnotify.yaml); generic fallback if it fails.
. "$(dirname "$(readlink -f "$0")")/opt.sh"
age="$(ps -o etimes= -C goimapnotify | sort -n | head -1 | tr -d ' ')"
[ "${age:-99}" -lt 10 ] && exit 0

PB_HOST="$(opt host 127.0.0.1)" PB_PORT="$(opt port 1143)" \
PB_USER="$(secret-tool lookup service proton-bridge-user)" PB_PASS="$(secret-tool lookup service proton-bridge-pass)" \
python3 - <<'PY' | {
import imaplib, os, html
from email import message_from_bytes
from email.header import decode_header, make_header
from email.utils import parseaddr

def dec(v):
    return str(make_header(decode_header(v))) if v else ""

try:
    c = imaplib.IMAP4(os.environ["PB_HOST"], int(os.environ["PB_PORT"]), timeout=10)
    c.starttls(__import__("ssl")._create_unverified_context())
    c.login(os.environ["PB_USER"], os.environ["PB_PASS"])
    c.select("INBOX", readonly=True)
    _, d = c.fetch("*", "(BODY.PEEK[HEADER.FIELDS (FROM SUBJECT)])")
    m = message_from_bytes(d[0][1])
    name, addr = parseaddr(dec(m["From"]))
    print(html.escape(name or addr or "Unknown sender"))
    print(html.escape(dec(m["Subject"]) or "(no subject)"))
    c.logout()
except Exception:
    pass
PY
    IFS= read -r from
    IFS= read -r subject
    if [ -n "$subject" ]; then
        notify-send -a "Proton Mail" -i mail-unread "Mail · $from" "$subject"
        "$HOME/.local/bin/bar-alert" push mail "$from" "$subject"
    else
        notify-send -a "Proton Mail" -i mail-unread "New mail" "Proton inbox"
        "$HOME/.local/bin/bar-alert" push mail "Proton" "New mail"
    fi
}
